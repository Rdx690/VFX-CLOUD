# ---- Railway provides DATABASE_URL and PORT automatically (reference the Postgres plugin) ----
DATABASE_URL=postgresql://user:pass@host:5432/db
NODE_ENV=production

# ---- Secrets (generate your own!) ----
# openssl rand -hex 32
SESSION_SECRET=
# exactly 64 hex chars (32 bytes): openssl rand -hex 32
ENCRYPTION_KEY=

# ---- First admin (created on first boot only if no admin exists) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Proxmox VE API (your own server; NOT Railway) ----
PROXMOX_URL=https://your-proxmox-host:8006
PROXMOX_TOKEN_ID=svxpanel@pve!panel
PROXMOX_TOKEN_SECRET=
# Only for self-signed certs. Prefer PROXMOX_CA_CERT instead.
PROXMOX_INSECURE_TLS=false
PROXMOX_CA_CERT=

# ---- Panel SSH key (ed25519, OpenSSH format). Newlines as \n ----
# ssh-keygen -t ed25519 -N "" -f panel_key ; then paste panel_key contents with \n for newlines
PLATFORM_SSH_PRIVATE_KEY=
